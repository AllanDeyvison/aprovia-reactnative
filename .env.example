# Public API addresses only. Never put credentials in EXPO_PUBLIC_*.
# Android emulator: replace localhost with 10.0.2.2; device: use your LAN host.
EXPO_PUBLIC_AUTH_API=http://localhost:8090
# Android emulator: EXPO_PUBLIC_AUTH_API=http://10.0.2.2:8090
# Physical device: EXPO_PUBLIC_AUTH_API=http://<machine-IPv4>:8090
EXPO_PUBLIC_CHAT_API=http://localhost:8000
